pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'avishkaweera20/devops-frontend'
        DOCKERHUB_CREDENTIALS = 'dockerhub'
        AWS_REGION = 'eu-north-1'
        EC2_USER = 'ubuntu'
    }

    stages {

        /* =========================
           1. CHECKOUT SOURCE CODE
        ========================== */
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Avishka-Weerasekara/DevOps.git'
            }
        }

        /* =========================
           2. BUILD DOCKER IMAGE
        ========================== */
        stage('Build Docker Image') {
            steps {
                dir('DevOps/frontend') {
                    sh """
docker build --no-cache \
  --build-arg BUILD_VERSION=${BUILD_NUMBER} \
  -t ${DOCKER_IMAGE}:latest \
  -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .
"""
                }
            }
        }

        /* =========================
           3. PUSH IMAGE TO DOCKER HUB
        ========================== */
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: DOCKERHUB_CREDENTIALS,
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin

docker push ${DOCKER_IMAGE}:latest
docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

docker logout
"""
                }
            }
        }

        /* =========================
           4. TERRAFORM APPLY
        ========================== */
        stage('Terraform Apply') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {
                    dir('DevOps/terraform') {
                        sh """
terraform init
terraform apply -auto-approve \
  -var="key_name=devops-key"
"""
                    }
                }
            }
        }

        /* =========================
           5. DEPLOY TO AWS EC2
        ========================== */
        stage('Deploy to AWS EC2') {
            steps {
                script {
                    def EC2_HOST = sh(
                        script: "terraform -chdir=DevOps/terraform output -raw ec2_public_ip",
                        returnStdout: true
                    ).trim()

                    echo "Deploying to EC2 IP: ${EC2_HOST}"

                    sshagent(credentials: ['bd4685d7-504d-4f3b-930c-075db4165b52']) {
                        sh """
ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} << 'EOF'
set -e

echo "Waiting for cloud-init / apt locks..."
while sudo fuser /var/lib/dpkg/lock >/dev/null 2>&1; do sleep 5; done
while sudo fuser /var/lib/apt/lists/lock >/dev/null 2>&1; do sleep 5; done

# Install Docker if missing
if ! command -v docker >/dev/null 2>&1; then
  sudo apt update -y
  sudo apt install -y docker.io
  sudo systemctl start docker
  sudo systemctl enable docker
fi

# Ensure docker daemon ready
until sudo docker info >/dev/null 2>&1; do
  echo "Waiting for Docker daemon..."
  sleep 5
done

# Deploy container
sudo docker pull ${DOCKER_IMAGE}:latest
sudo docker stop frontend || true
sudo docker rm frontend || true
sudo docker run -d \
  --restart always \
  -p 80:3000 \
  --name frontend \
  ${DOCKER_IMAGE}:latest

echo "Deployment completed successfully"
EOF
"""
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ CI/CD Pipeline completed successfully"
        }
        failure {
            echo "❌ CI/CD Pipeline failed"
        }
    }
}
