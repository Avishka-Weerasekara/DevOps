pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'avishkaweera20/devops-frontend'
        DOCKERHUB_CREDENTIALS = 'dockerhub'
        AWS_REGION = 'eu-north-1'
        EC2_USER = 'ubuntu'
    }

    stages {

        /* =========================
           1. CHECKOUT SOURCE CODE
        ========================== */
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Avishka-Weerasekara/DevOps.git'
            }
        }

        /* =========================
           2. BUILD DOCKER IMAGE
        ========================== */
        stage('Build Docker Image') {
            steps {
                dir('DevOps/frontend') {
                    sh 'docker build -t $DOCKER_IMAGE:latest .'
                }
            }
        }

        /* =========================
           3. PUSH IMAGE TO DOCKER HUB
        ========================== */
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: DOCKERHUB_CREDENTIALS,
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
docker push $DOCKER_IMAGE:latest
docker logout
'''
                }
            }
        }

        /* =========================
           4. TERRAFORM INIT & APPLY
        ========================== */
        stage('Terraform Apply') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {
                    dir('DevOps/terraform') {
                        sh '''
terraform init
terraform apply -auto-approve \
  -var="key_name=your-keypair-name"
'''
                    }
                }
            }
        }

        /* =========================
           5. DEPLOY TO EC2
        ========================== */
        stage('Deploy to AWS EC2') {
            steps {
                script {
                    // Get EC2 public IP from Terraform output
                    def EC2_HOST = sh(
                        script: "terraform -chdir=DevOps/terraform output -raw ec2_public_ip",
                        returnStdout: true
                    ).trim()

                    echo "Deploying to EC2 IP: ${EC2_HOST}"

                    sshagent(credentials: ['bd4685d7-504d-4f3b-930c-075db4165b52']) {
                        sh """
ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} <<EOF
docker pull ${DOCKER_IMAGE}:latest
docker stop frontend || true
docker rm frontend || true
docker run -d -p 80:3000 --name frontend ${DOCKER_IMAGE}:latest
EOF
"""
                    }
                }
            }
        }
    }
}
